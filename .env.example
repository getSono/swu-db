# Vorlage für lokale Einstellungen: als .env kopieren und anpassen.
# Einlesen z. B. mit: node --env-file=.env src/server.js (Node.js 20.6+)
# Ohne .env gelten die Standardwerte aus src/server.js.

# Port des HTTP-Servers (Standard: 3000)
PORT=3000

# Adresse, auf der gelauscht wird (Standard: 0.0.0.0)
# 127.0.0.1, wenn nur cloudflared auf demselben Host zugreifen soll
HOST=0.0.0.0

# Öffentliche Adresse hinter Cloudflare Tunnel; leer = aus
# X-Forwarded-Proto und X-Forwarded-Host ableiten
PUBLIC_BASE_URL=

# SWU-API (Standard: https://api.swu.de/mobility/v1)
SWU_BASE_URL=https://api.swu.de/mobility/v1
